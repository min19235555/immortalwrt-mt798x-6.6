part uuid ${devtype} ${devnum}:2 uuid

if test $soc = 'rk3308'; then
	serial_addr=',0xff0c0000'; serial_port='ttyS2';
elif test $soc = 'rk3328'; then
	serial_addr=',0xff130000'; serial_port='ttyS2';
elif test $soc = 'rk3399'; then
	serial_addr=',0xff1a0000'; serial_port='ttyS2';
elif test $soc = 'rk3528'; then
	serial_addr=',0xff9f0000'; serial_port='ttyS0';
elif test $soc = 'rk3568'; then
	serial_addr=',0xfe660000'; serial_port='ttyS2';
elif test $soc = 'rk3576'; then
	serial_addr=',0x2ad40000'; serial_port='ttyS0';
elif test $soc = 'rk3588'; then
	serial_addr=',0xfeb50000'; serial_port='ttyS2';
fi

setenv bootargs "coherent_pool=2M console=tty1 console=${serial_port},1500000 earlycon=uart8250,mmio32${serial_addr} root=PARTUUID=${uuid} rw rootwait pci=realloc";

# Radxa CM5 Lite carrier (ASM1184E + MTK T700 5G modem):
# the modem needs several seconds after power-on before its PCIe link trains.
# If Linux enumerates the bus before that, the modem is absent at boot and its
# 8 MiB BARs can never be allocated afterwards ("can't assign; no space"),
# because the root port windows are already sized for the other devices.
# Waiting here makes all four downstream devices present during enumeration.
sleep 15

load ${devtype} ${devnum}:1 ${kernel_addr_r} kernel.img

bootm ${kernel_addr_r}
